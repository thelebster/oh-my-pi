PI_HOST=mypi.local
PI_USER=pi
PI_HOSTNAME=mypi
SSH_KEY=

ZERO_PI_HOST=zeropi.local
ZERO_PI_USER=pi
ZERO_PI_HOSTNAME=zeropi
ZERO_PI_SSH_KEY=~/.ssh/zeropi

PINAS_HOST=pinas.local
PINAS_USER=pi
PINAS_HOSTNAME=pinas
PINAS_SSH_KEY=~/.ssh/pinas

#CF_API_TOKEN=your-cloudflare-api-token
#CF_ZONE_ID=your-zone-id
#CF_DOMAIN=mypi.example.com
#CF_TUNNEL_TOKEN=your-cloudflare-tunnel-token
#CF_TUNNEL_SSH_HOST=ssh-mypi
#CF_TUNNEL_HTTP_HOST=mypi

# Raspberry Pi Connect auth key (connect.raspberrypi.com → Settings → Auth keys) for non-interactive sign-in
#RPI_CONNECT_AUTH_KEY=

# Tailscale (https://login.tailscale.com/admin/settings/keys): reusable + pre-authorized key
#TAILSCALE_AUTH_KEY=tskey-auth-...
#TAILSCALE_SSH=false           # true|false, or 1|0 (also yes/no, on/off)
#TAILSCALE_SSHD_PORT=2222      # with TAILSCALE_SSH=true: key-based sshd on this tailnet port, Tailscale SSH keeps 22
#PI_SSH_PORT=2222              # Ansible SSH port for mypi (default 22); set only after `ssh -p 2222` works

#TELEGRAM_BOT_TOKEN=your-telegram-bot-token
#TELEGRAM_ALLOWED_USERS=your_username

#LOG_LEVEL=INFO

#PIHOLE_PASSWORD=changeme
#PIHOLE_TZ=UTC

#TOR_HIDDEN_SERVICE_PORT=80
#TOR_HIDDEN_SERVICE_TARGET=127.0.0.1:80
#TOR_VANITY_KEYS_DIR=.tor/mypixxx.onion
#TOR_VANITY_PREFIX=mypi

#ZERO_PI_CF_TUNNEL_TOKEN=your-zeropi-tunnel-token
# HTTP_HOST/SSH_HOST not needed if using config file (ansible/files/cloudflared/zeropi.yml)
#ZERO_PI_CF_TUNNEL_HTTP_HOST=cam
#ZERO_PI_CF_TUNNEL_SSH_HOST=ssh-zeropi

#PINAS_CF_TUNNEL_TOKEN=your-pinas-tunnel-token
# HTTP_HOST/SSH_HOST not needed if using config file (ansible/files/cloudflared/pinas.yml)
#PINAS_CF_TUNNEL_HTTP_HOST=nas
#PINAS_CF_TUNNEL_SSH_HOST=ssh-pinas

#JELLYFIN_TZ=UTC

#HA_TZ=UTC

#CLAUDE_DANGEROUS_MODE=true
